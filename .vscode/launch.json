{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Trilha B — Quality Checks",
      "type": "debugpy",
      "request": "launch",
      "module": "src.quality.cli",
      "args": ["--layer", "bronze"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Trilha B — Testes",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "tests/test_checks.py"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}